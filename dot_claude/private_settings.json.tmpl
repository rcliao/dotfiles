{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "auto"
  },
  "skillOverrides": {
    "zero": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{ .chezmoi.homeDir }}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); current_dir=$(echo \"$input\" | jq -r '.workspace.current_dir'); model=$(echo \"$input\" | jq -r '.model.display_name'); dir_name=$(basename \"$current_dir\"); if git -C \"$current_dir\" rev-parse --git-dir >/dev/null 2>&1; then branch=$(git -C \"$current_dir\" branch --show-current 2>/dev/null); if [ -n \"$branch\" ]; then git_info=\" ($branch)\"; else git_info=\" (git)\"; fi; else git_info=\"\"; fi; printf \"%s%s • %s\" \"$dir_name\" \"$git_info\" \"$model\""
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "zero@zero-plugins": true
  },
  "extraKnownMarketplaces": {
    "zero-plugins": {
      "source": {
        "source": "github",
        "repo": "officialzeroxyz/zero-plugins"
      }
    }
  },
  "sandbox": {
    "network": {
      "allowedDomains": [
        "*.zero.xyz"
      ]
    }
  },
  "alwaysThinkingEnabled": true,
  "editorMode": "vim",
  "verbose": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "feedbackSurveyState": {
    "lastShownTime": 1754085573630
  },
  "skipWorkflowUsageWarning": true
}
