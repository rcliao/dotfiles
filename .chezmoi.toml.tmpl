{{/*
Generates ~/.config/chezmoi/chezmoi.toml on `chezmoi init`.

Per-machine values live here, NOT in .chezmoidata.toml, so a work laptop and a
personal workstation can share this source repo with different git identities
and different opt-in features. promptStringOnce and promptBoolOnce only ask
when the value is not already set, so re-running `chezmoi init` on a
configured machine is non-interactive and preserves what is already there.

NOTE: .chezmoidata.toml is NOT in scope while this template runs — chezmoi
loads it for the source state, not for the config file. Passing `.email` or
`.name` as a default here fails with "map has no entry for key", which breaks
`chezmoi init` outright. The defaults below must be literals.

The literal defaults also make `chezmoi init --promptDefaults` work
unattended. They default to the personal identity with Ghost off, so an
unattended install never silently picks up a work address.
*/ -}}
{{- $name  := promptStringOnce . "name"  "Full name for git commits" "Eric Liao" -}}
{{- $email := promptStringOnce . "email" "Git email for THIS machine (work vs personal)" "rcliao01@gmail.com" -}}
{{- $ghost := promptBoolOnce   . "ghost" "Install the Ghost MCP memory hooks on this machine" false -}}

[data]
    name = {{ $name | quote }}
    email = {{ $email | quote }}
    # Gates the ghost-* Claude Code hooks in .chezmoiignore and settings.json.
    ghost = {{ $ghost }}
