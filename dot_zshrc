# homebrew
eval $(/opt/homebrew/bin/brew shellenv)

export EDITOR=nvim

# History. The defaults keep 1000 entries and each shell overwrites the file on
# exit, which loses almost everything when several herdr panes run at once.
# SHARE_HISTORY + INC_APPEND_HISTORY make panes append to a common file live.
HISTFILE=~/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY INC_APPEND_HISTORY EXTENDED_HISTORY
setopt HIST_IGNORE_DUPS HIST_IGNORE_ALL_DUPS HIST_REDUCE_BLANKS
setopt HIST_IGNORE_SPACE      # a leading space keeps a command out of history
setopt HIST_VERIFY            # expand !! and friends for review instead of running

# Zsh theme
fpath+=("$(brew --prefix)/share/zsh/site-functions")
autoload -U promptinit; promptinit
prompt pure

# vi keys on the command line. zsh already picks this keymap on its own because
# $EDITOR contains "vi"; saying so keeps it from silently changing if EDITOR does.
bindkey -v

# Go Settings
export GOPATH="$HOME/dev/go"
export PATH=$PATH:$GOPATH/bin

# custom installed binary
export PATH=$PATH:~/bin

# Java. Homebrew's openjdk is keg-only and not registered with macOS, so
# /usr/libexec/java_home cannot find it; point at the keg, and only fall back to
# java_home for a system-installed JDK.
if [ -d /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home ]; then
    export JAVA_HOME=/opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home
elif /usr/libexec/java_home >/dev/null 2>&1; then
    export JAVA_HOME=$(/usr/libexec/java_home)
fi

# fzf settings – enables fuzzy search with "**" like `nvim **`
# Set up fzf key bindings and fuzzy completion
eval "$(fzf --zsh)"
# use fd as default find command to traverse the file system while respecting .gitignore
export FZF_DEFAULT_COMMAND='fd --type f --hidden --follow --exclude .git'

# atuin: history search that knows each command's directory, exit code and
# duration. Must come after fzf, since both bind ^R and the last one wins.
# The up arrow is left alone; ~/.zsh_history keeps being written as before, so
# removing these lines is all it takes to back out.
if [ -x "$(command -v atuin)" ]; then
    eval "$(atuin init zsh --disable-up-arrow)"
fi

# for gpg
export GPG_TTY=$(tty)

# rust-lang cargo env
export PATH="$HOME/.cargo/bin:$PATH"

# $HOME/.local/bin for claude code. /usr/local/bin is already on the default
# macOS PATH; prepending it here put stale Intel-era binaries ahead of Homebrew.
export PATH="$HOME/.local/bin:$PATH"

# python
export PATH="/opt/homebrew/opt/python/libexec/bin:$PATH"

# SSH keys load on demand: ~/.ssh/config sets AddKeysToAgent + UseKeychain on
# every host, so the passphrase comes from Keychain at first use. An eager
# `ssh-add -A` here cost ~420ms of every shell start for no benefit.

# directory jumping
if [ -x "$(command -v zoxide)" ]; then
    eval "$(zoxide init zsh)"
fi

# Java
export PATH="/opt/homebrew/opt/openjdk/bin:$PATH"

# Google Cloud SDK: the Homebrew cask if present, otherwise a manual install
# unpacked in ~/Downloads. Completion is sourced further down, after compinit.
for _gcloud_sdk in "$HOMEBREW_PREFIX/share/google-cloud-sdk" "$HOME/Downloads/google-cloud-sdk"; do
    [ -f "$_gcloud_sdk/path.zsh.inc" ] && break
    _gcloud_sdk=
done
[ -n "$_gcloud_sdk" ] && . "$_gcloud_sdk/path.zsh.inc"

# Initialize completions once, reusing ~/.zcompdump unless it is over a day
# old. gcloud's completion.zsh.inc below runs its own uncached `compinit` when
# compdef is undefined, which rebuilds the dump from scratch (~190ms). Doing it
# here first means that branch is skipped.
# NOTE: the glob must be in an array assignment — [[ ]] suppresses globbing, so
# the common `[[ -n ~/.zcompdump(#qNmh+24) ]]` idiom is always true.
autoload -Uz compinit
_zcompdump_stale=(~/.zcompdump(N.mh+24))
if (( ${#_zcompdump_stale} )); then compinit; else compinit -C; fi
unset _zcompdump_stale

[ -n "$_gcloud_sdk" ] && . "$_gcloud_sdk/completion.zsh.inc"
unset _gcloud_sdk

# Zero CLI
export PATH="$HOME/.zero/bin:$PATH"

# Zero runner (added by the zero plugin SessionStart hook)
export PATH="$HOME/.zero/runtime/bin:$PATH"

# Per-project runtime versions (mise.toml / .tool-versions). Deliberately last:
# mise prepends to PATH, and every export above would otherwise shadow the
# versions a project pins. Guarded so a machine without mise still starts.
if [ -x "$(command -v mise)" ]; then
    eval "$(mise activate zsh)"
fi
