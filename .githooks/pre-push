#!/bin/sh
# Runs before every `git push` from this clone. This repo is public, so the
# checks are about what must never leave the machine:
#
#   1. gitleaks over the commits being pushed (API keys, tokens, private keys).
#   2. Any pattern in ~/.config/chezmoi/forbidden-words, one extended regex per
#      line, `#` comments allowed. That file is where employer and internal
#      names go; it is per-machine and never committed, because writing those
#      names into a public repo to block them would defeat the point.
#
# Enabled by `git config core.hooksPath .githooks`, which the chezmoi script
# run_onchange_after_enable-git-hooks.sh does on apply.
# Bypass for a genuine false positive: git push --no-verify

words="${XDG_CONFIG_HOME:-$HOME/.config}/chezmoi/forbidden-words"
zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  # deleting a remote branch pushes nothing to scan
  [ "$local_sha" = "$zero" ] && continue

  if [ "$remote_sha" = "$zero" ]; then
    # new branch: everything not already on some remote
    range="$local_sha --not --remotes"
  else
    range="$remote_sha..$local_sha"
  fi

  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" || status=1
  else
    echo "pre-push: gitleaks not installed, secret scan SKIPPED (brew install gitleaks)" >&2
  fi

  if [ -f "$words" ]; then
    # only added lines; $range is deliberately unquoted, it is several arguments
    # shellcheck disable=SC2086
    hits=$(git log -p --no-color --format='commit %h' $range |
      grep -E '^(commit |\+[^+])' |
      grep -iE -f "$words" | grep -v '^commit ')
    if [ -n "$hits" ]; then
      echo "pre-push: forbidden words in the commits being pushed:" >&2
      echo "$hits" | cut -c1-160 >&2
      status=1
    fi
  fi
done

[ "$status" -eq 0 ] || echo "pre-push: push blocked. Fix the commits, or --no-verify if it is a false positive." >&2
exit "$status"
